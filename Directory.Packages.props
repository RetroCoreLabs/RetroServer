<Project>
  <!-- Central package versions. Generated by rename.py from the highest version seen per package; edit by hand afterwards. -->
  <PropertyGroup>
    <!-- The app repos reference RetroIO as 0.1.0-local.* so a fresh publish-local stamp is always
         picked up. Central Package Management REJECTS a floating PackageVersion unless this is on
         (NU1011), so the local-feed workflow does not build without it. -->
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
    <!-- Needed so the Tmds.DBus.Protocol pin below actually applies: it is a TRANSITIVE
         dependency of Avalonia, and central pinning ignores those unless this is on. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Transitive pin. Avalonia 11.3.6 pulls Tmds.DBus.Protocol 0.21.2, which carries a high
         severity advisory (GHSA-xrw6-gwf8-vvr9, spoofed D-Bus signals and fd exhaustion).
         0.21.3 is the patch on the same line, so Avalonia gets the API it expects. Pinning it
         needs CentralPackageTransitivePinningEnabled: without that, a PackageVersion for a
         package nothing references directly is ignored and the advisory stays.
         Remove both once Avalonia ships a build that asks for 0.21.3 or later itself. -->
    <PackageVersion Include="Tmds.DBus.Protocol" Version="0.21.3" />

    <PackageVersion Include="Avalonia" Version="11.3.6" />
    <PackageVersion Include="Avalonia.Controls.DataGrid" Version="11.3.6" />
    <PackageVersion Include="Avalonia.Desktop" Version="11.3.6" />
    <PackageVersion Include="Avalonia.Diagnostics" Version="11.3.6" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="11.3.6" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="11.3.6" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.2.1" />
    <PackageVersion Include="LiveChartsCore.SkiaSharpView.Avalonia" Version="2.0.0-rc4.5" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="9.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="9.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="9.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="9.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="9.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageVersion Include="NUnit" Version="4.3.1" />
    <PackageVersion Include="NUnit.Analyzers" Version="4.5.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageVersion Include="System.ServiceProcess.ServiceController" Version="9.0.0" />
    <PackageVersion Include="RetroIO.Identity" Version="0.1.0-local.*" />
    <PackageVersion Include="RetroIO.Management.Client" Version="0.1.0-local.*" />
    <PackageVersion Include="RetroIO.Management.Contracts" Version="0.1.0-local.*" />
    <PackageVersion Include="RetroIO.Protocols.Econet" Version="0.1.0-local.*" />
    <PackageVersion Include="RetroIO.Protocols.Tnfs" Version="0.1.0-local.*" />
    <PackageVersion Include="RetroIO.Security.Firewall" Version="0.1.0-local.*" />
    <PackageVersion Include="RetroIO.Security.Implementation" Version="0.1.0-local.*" />
    <PackageVersion Include="RetroIO.Server" Version="0.1.0-local.*" />
    <PackageVersion Include="RetroIO.Server.Core" Version="0.1.0-local.*" />
    <PackageVersion Include="RetroIO.Server.Hosting" Version="0.1.0-local.*" />
    <PackageVersion Include="RetroIO.Storage.Azure" Version="0.1.0-local.*" />
    <PackageVersion Include="RetroIO.Storage.Utilities" Version="0.1.0-local.*" />
  </ItemGroup>
</Project>
