<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:RetroAdmin.Desktop.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="RetroAdmin.Desktop.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <StackPanel Spacing="20">
        <TextBlock Text="Dashboard"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="{DynamicResource RetroFSGreenBrush}"/>

        <Border Background="{DynamicResource RetroFSBackgroundLightBrush}"
                BorderBrush="{DynamicResource RetroFSBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20">
            <StackPanel Spacing="10">
                <TextBlock Text="Server Information"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{DynamicResource RetroFSWhiteBrush}"/>
                <TextBlock Text="{Binding ServerInfo}"
                           Foreground="{DynamicResource RetroFSLightGrayBrush}"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
