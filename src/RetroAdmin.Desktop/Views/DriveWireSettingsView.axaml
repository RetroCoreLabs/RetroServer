<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RetroAdmin.Desktop.ViewModels"
             x:Class="RetroAdmin.Desktop.Views.DriveWireSettingsView"
             x:DataType="vm:DriveWireSettingsViewModel">

    <!-- Every key of drivewire-config.json. The server reads the file at start. -->
    <StackPanel Spacing="10">
        <TextBlock Text="DriveWire" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource RetroFSGreenBrush}"/>

        <Border Background="{DynamicResource RetroFSBackgroundAltBrush}" BorderBrush="{DynamicResource RetroFSBorderBrush}"
                BorderThickness="1" CornerRadius="4" Padding="12">
            <StackPanel Spacing="6">
                <TextBlock Text="Settings (take effect when RetroServer restarts)" FontWeight="Bold" Foreground="{DynamicResource RetroFSOrangeBrush}"/>
                <CheckBox Content="Run the DriveWire server" IsChecked="{Binding Enabled}" Foreground="{DynamicResource RetroFSWhiteBrush}"/>
                <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Text="TCP port" VerticalAlignment="Center" Foreground="{DynamicResource RetroFSLightGrayBrush}"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Port}" Margin="0,2"/>
                    <TextBlock Grid.Row="1" Text="Listen address" VerticalAlignment="Center" Foreground="{DynamicResource RetroFSLightGrayBrush}"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding BindAddress}" Margin="0,2" ToolTip.Tip="127.0.0.1 = this computer only. 0.0.0.0 = other computers too."/>
                    <TextBlock Grid.Row="2" Text="Byte time limit (ms)" VerticalAlignment="Center" Foreground="{DynamicResource RetroFSLightGrayBrush}"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding TransactionTimeoutMilliseconds}" Margin="0,2" ToolTip.Tip="How long to wait for the next byte inside one request before giving it up."/>
                    <TextBlock Grid.Row="3" Text="Drives" VerticalAlignment="Top" Margin="0,6,0,0" Foreground="{DynamicResource RetroFSLightGrayBrush}"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Drives}" AcceptsReturn="True" Height="120" Margin="0,2"
                             Watermark="0 = /disks/boot.dsk&#10;1 = /disks/games.dsk, read-only"
                             ToolTip.Tip="One drive per line: number = image file. Add ', read-only' to refuse writes."/>
                    <TextBlock Grid.Row="4" Text="Named object folder" VerticalAlignment="Center" Foreground="{DynamicResource RetroFSLightGrayBrush}"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding NamedObjectDirectory}" Watermark="a folder on the server, or empty" Margin="0,2"/>
                    <TextBlock Grid.Row="5" Text="Print folder" VerticalAlignment="Center" Foreground="{DynamicResource RetroFSLightGrayBrush}"/>
                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding PrintDirectory}" Watermark="a folder on the server, or empty" Margin="0,2"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Save" Command="{Binding SaveSettingsCommand}"
                            Background="{DynamicResource RetroFSBackgroundLightBrush}" Foreground="{DynamicResource RetroFSWhiteBrush}"/>
                    <Button Content="Reload" Command="{Binding LoadSettingsCommand}"
                            Background="{DynamicResource RetroFSBackgroundLightBrush}" Foreground="{DynamicResource RetroFSWhiteBrush}"/>
                </StackPanel>
                <TextBlock Text="{Binding SettingsMessage}" TextWrapping="Wrap" Foreground="{DynamicResource RetroFSOrangeBrush}"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
