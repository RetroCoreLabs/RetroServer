<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:RetroAdmin.Desktop.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="RetroAdmin.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <StackPanel Spacing="20">
        <TextBlock Text="Server Settings"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="{DynamicResource RetroFSGreenBrush}"/>

        <Border Background="{DynamicResource RetroFSBackgroundLightBrush}"
                BorderBrush="{DynamicResource RetroFSBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20">
            <StackPanel Spacing="10">
                <TextBlock Text="TNFS Configuration"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="{DynamicResource RetroFSWhiteBrush}"/>

                <TextBlock Text="Root Directory:"
                           Foreground="{DynamicResource RetroFSLightGrayBrush}"/>
                <CheckBox IsChecked="{Binding TnfsEnabled}"
                          Content="Run the TNFS server"
                          Foreground="{DynamicResource RetroFSWhiteBrush}"/>

                <TextBox Text="{Binding TnfsRootDirectory}"
                         Background="{DynamicResource RetroFSBackgroundBrush}"
                         Foreground="{DynamicResource RetroFSWhiteBrush}"/>

                <CheckBox IsChecked="{Binding EnableUdp}"
                          Content="Enable UDP"
                          Foreground="{DynamicResource RetroFSWhiteBrush}"/>

                <TextBlock Text="UDP Port:"
                           Foreground="{DynamicResource RetroFSLightGrayBrush}"/>
                <NumericUpDown Value="{Binding UdpPort}"
                               Minimum="1"
                               Maximum="65535"
                               Background="{DynamicResource RetroFSBackgroundBrush}"
                               Foreground="{DynamicResource RetroFSWhiteBrush}"/>

                <CheckBox IsChecked="{Binding EnableTcp}"
                          Content="Enable TCP"
                          Foreground="{DynamicResource RetroFSWhiteBrush}"/>

                <TextBlock Text="TCP Port:"
                           Foreground="{DynamicResource RetroFSLightGrayBrush}"/>
                <NumericUpDown Value="{Binding TcpPort}"
                               Minimum="1"
                               Maximum="65535"
                               Background="{DynamicResource RetroFSBackgroundBrush}"
                               Foreground="{DynamicResource RetroFSWhiteBrush}"/>
                <TextBlock Text="Most TCP connections at once:"
                           Foreground="{DynamicResource RetroFSLightGrayBrush}"/>
                <NumericUpDown Value="{Binding TnfsMaxTcpConnections}"
                               Minimum="1"
                               Maximum="1000000"
                               Background="{DynamicResource RetroFSBackgroundBrush}"
                               Foreground="{DynamicResource RetroFSWhiteBrush}"/>
                <TextBlock Text="Most sessions at once:"
                           Foreground="{DynamicResource RetroFSLightGrayBrush}"/>
                <NumericUpDown Value="{Binding TnfsMaxSessions}"
                               Minimum="1"
                               Maximum="1000000"
                               Background="{DynamicResource RetroFSBackgroundBrush}"
                               Foreground="{DynamicResource RetroFSWhiteBrush}"/>
                <TextBlock Text="Most sessions from one address:"
                           Foreground="{DynamicResource RetroFSLightGrayBrush}"/>
                <NumericUpDown Value="{Binding TnfsMaxSessionsPerIp}"
                               Minimum="1"
                               Maximum="1000000"
                               Background="{DynamicResource RetroFSBackgroundBrush}"
                               Foreground="{DynamicResource RetroFSWhiteBrush}"/>
                <TextBlock Text="Drop an idle session after (seconds):"
                           Foreground="{DynamicResource RetroFSLightGrayBrush}"/>
                <NumericUpDown Value="{Binding TnfsSessionTimeoutSeconds}"
                               Minimum="1"
                               Maximum="86400"
                               Background="{DynamicResource RetroFSBackgroundBrush}"
                               Foreground="{DynamicResource RetroFSWhiteBrush}"/>
            </StackPanel>
        </Border>

        <Border Background="{DynamicResource RetroFSBackgroundLightBrush}"
                BorderBrush="{DynamicResource RetroFSBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20">
            <StackPanel Spacing="10">
                <TextBlock Text="Econet Configuration"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="{DynamicResource RetroFSWhiteBrush}"/>

                <TextBlock Text="Root Directory:"
                           Foreground="{DynamicResource RetroFSLightGrayBrush}"/>
                <CheckBox IsChecked="{Binding EconetEnabled}"
                          Content="Run the Econet file server"
                          Foreground="{DynamicResource RetroFSWhiteBrush}"/>

                <TextBox Text="{Binding EconetRootDirectory}"
                         Background="{DynamicResource RetroFSBackgroundBrush}"
                         Foreground="{DynamicResource RetroFSWhiteBrush}"/>

                <TextBlock Text="Disc Name:"
                           Foreground="{DynamicResource RetroFSLightGrayBrush}"/>
                <TextBox Text="{Binding EconetDiscName}"
                         Background="{DynamicResource RetroFSBackgroundBrush}"
                         Foreground="{DynamicResource RetroFSWhiteBrush}"/>

                <TextBlock Text="Version text (what the BBC sees; empty for none):"
                           Foreground="{DynamicResource RetroFSLightGrayBrush}"/>
                <TextBox Text="{Binding EconetVersionString}"
                         Background="{DynamicResource RetroFSBackgroundBrush}"
                         Foreground="{DynamicResource RetroFSWhiteBrush}"/>

                <CheckBox IsChecked="{Binding EconetEnableUdp}"
                          Content="Enable UDP AUN"
                          Foreground="{DynamicResource RetroFSWhiteBrush}"/>

                <TextBlock Text="UDP Port:"
                           Foreground="{DynamicResource RetroFSLightGrayBrush}"/>
                <NumericUpDown Value="{Binding EconetUdpPort}"
                               Minimum="1"
                               Maximum="65535"
                               Background="{DynamicResource RetroFSBackgroundBrush}"
                               Foreground="{DynamicResource RetroFSWhiteBrush}"/>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                    <StackPanel Grid.Column="0" Spacing="5">
                        <TextBlock Text="Network:"
                                   Foreground="{DynamicResource RetroFSLightGrayBrush}"/>
                        <NumericUpDown Value="{Binding EconetNet}"
                                       Minimum="0"
                                       Maximum="255"
                                       Background="{DynamicResource RetroFSBackgroundBrush}"
                                       Foreground="{DynamicResource RetroFSWhiteBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="5">
                        <TextBlock Text="Station:"
                                   Foreground="{DynamicResource RetroFSLightGrayBrush}"/>
                        <NumericUpDown Value="{Binding EconetStation}"
                                       Minimum="0"
                                       Maximum="255"
                                       Background="{DynamicResource RetroFSBackgroundBrush}"
                                       Foreground="{DynamicResource RetroFSWhiteBrush}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Which byte of a client's IP address is its station number (0 to 3; 3 is the last):"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource RetroFSLightGrayBrush}"/>
                <NumericUpDown Value="{Binding EconetStationByte}"
                               Minimum="0"
                               Maximum="3"
                               Background="{DynamicResource RetroFSBackgroundBrush}"
                               Foreground="{DynamicResource RetroFSWhiteBrush}"/>

                <TextBlock Text="Reply format (LaterFS for ANFS / DNFS 3.60, Classic1983 for the oldest clients):"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource RetroFSLightGrayBrush}"/>
                <ComboBox ItemsSource="{Binding WireProfiles}"
                          SelectedItem="{Binding EconetWireProfile}"/>

                <TextBlock Text="Machines with another reply format, one per line (network.station = format):"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource RetroFSLightGrayBrush}"/>
                <TextBox Text="{Binding EconetWireOverrides}"
                         AcceptsReturn="True"
                         Height="70"
                         Watermark="1.100 = Classic1983"
                         Background="{DynamicResource RetroFSBackgroundBrush}"
                         Foreground="{DynamicResource RetroFSWhiteBrush}"/>

                <TextBlock Text="Discs from their own storage, one per line. Empty: every folder in the root is a disc."
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource RetroFSLightGrayBrush}"/>
                <TextBox Text="{Binding EconetDiscs}"
                         AcceptsReturn="True"
                         Height="90"
                         Watermark="0 | Games | native:/discs/games&#10;1 | Work | mount:work-volume | read-only, folder=1Work"
                         ToolTip.Tip="number | disc name | native:ADDRESS, tnfs:ADDRESS or mount:VOLUME-ID | options (read-only, folder=NAME)"
                         Background="{DynamicResource RetroFSBackgroundBrush}"
                         Foreground="{DynamicResource RetroFSWhiteBrush}"/>
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="Save Settings"
                    Command="{Binding SaveSettingsCommand}"
                    Background="{DynamicResource RetroFSGreenBrush}"
                    Foreground="{DynamicResource RetroFSBackgroundBrush}"
                    Padding="15,5"/>

            <Button Content="Restart Server"
                    Command="{Binding RestartServerCommand}"
                    Background="{DynamicResource RetroFSOrangeBrush}"
                    Foreground="{DynamicResource RetroFSBackgroundBrush}"
                    Padding="15,5"/>
        </StackPanel>

        <TextBlock Text="{Binding StatusMessage}"
                   Foreground="{DynamicResource RetroFSLightGrayBrush}"
                   TextWrapping="Wrap"/>
    </StackPanel>
</UserControl>
