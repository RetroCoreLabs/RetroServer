<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:RetroAdmin.Desktop.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="800"
             x:Class="RetroAdmin.Desktop.Views.TelemetryView"
             x:DataType="vm:TelemetryViewModel">

    <!-- Metrics and log of every part of RetroServer, in one shape (api/v1/telemetry).
         Left: the parts that report. Right, top: the chosen part's metrics. Right, bottom: its log. -->
    <Grid RowDefinitions="Auto,Auto,*" ColumnDefinitions="220,*">

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Telemetry" FontSize="24" FontWeight="Bold"
                   Foreground="{DynamicResource RetroFSGreenBrush}" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Message}" TextWrapping="Wrap" Margin="0,0,0,6"
                   Foreground="{DynamicResource RetroFSOrangeBrush}"
                   IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

        <Border Grid.Row="2" Grid.Column="0" Background="{DynamicResource RetroFSBackgroundAltBrush}"
                BorderBrush="{DynamicResource RetroFSBorderBrush}" BorderThickness="1"
                CornerRadius="4" Padding="6" Margin="0,0,10,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Parts" FontWeight="Bold" Margin="4,0,0,6"
                           Foreground="{DynamicResource RetroFSOrangeBrush}"/>
                <ListBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2" Grid.Column="1" RowDefinitions="Auto,*,Auto,2*">
            <TextBlock Grid.Row="0" Text="Metrics" FontWeight="Bold" Margin="0,0,0,6"
                       Foreground="{DynamicResource RetroFSOrangeBrush}"/>
            <DataGrid Grid.Row="1" ItemsSource="{Binding Metrics}" AutoGenerateColumns="False" IsReadOnly="True"
                      GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="260"/>
                    <DataGridTextColumn Header="Labels" Binding="{Binding Labels}" Width="180"/>
                    <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="110"/>
                    <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="90"/>
                    <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="120"/>
                    <DataGridTextColumn Header="What it counts" Binding="{Binding Description}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="2" Text="Log" FontWeight="Bold" Margin="0,10,0,6"
                       Foreground="{DynamicResource RetroFSOrangeBrush}"/>
            <DataGrid Grid.Row="3" ItemsSource="{Binding LogRows}" AutoGenerateColumns="False" IsReadOnly="True"
                      GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Time" Binding="{Binding Time, StringFormat='{}{0:HH:mm:ss}'}" Width="90"/>
                    <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="100"/>
                    <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
                    <DataGridTextColumn Header="Attributes" Binding="{Binding Attributes}" Width="300"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
