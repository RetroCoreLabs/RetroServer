<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:RetroAdmin.Desktop.ViewModels"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="800"
             x:Class="RetroAdmin.Desktop.Views.TnfsMonitorView"
             x:DataType="vm:TnfsMonitorViewModel">

    <ScrollViewer>
        <StackPanel Spacing="20">
            <!-- Header -->
            <TextBlock Text="TNFS Server Monitor"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{DynamicResource RetroFSGreenBrush}"/>

            <!-- Status Cards -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="15">
                <!-- Active Connections -->
                <Border Grid.Column="0"
                        Background="{DynamicResource RetroFSBackgroundLightBrush}"
                        BorderBrush="{DynamicResource RetroFSBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="15">
                    <StackPanel>
                        <TextBlock Text="Active Connections"
                                   Foreground="{DynamicResource RetroFSLightGrayBrush}"
                                   FontSize="12"/>
                        <TextBlock Text="{Binding ActiveConnections}"
                                   Foreground="{DynamicResource RetroFSGreenBrush}"
                                   FontSize="32"
                                   FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <!-- Total Requests -->
                <Border Grid.Column="1"
                        Background="{DynamicResource RetroFSBackgroundLightBrush}"
                        BorderBrush="{DynamicResource RetroFSBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="15">
                    <StackPanel>
                        <TextBlock Text="Total Requests"
                                   Foreground="{DynamicResource RetroFSLightGrayBrush}"
                                   FontSize="12"/>
                        <TextBlock Text="{Binding TotalRequests}"
                                   Foreground="{DynamicResource RetroFSOrangeBrush}"
                                   FontSize="32"
                                   FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <!-- Bytes Transferred -->
                <Border Grid.Column="2"
                        Background="{DynamicResource RetroFSBackgroundLightBrush}"
                        BorderBrush="{DynamicResource RetroFSBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="15">
                    <StackPanel>
                        <TextBlock Text="Bytes Transferred"
                                   Foreground="{DynamicResource RetroFSLightGrayBrush}"
                                   FontSize="12"/>
                        <TextBlock Text="{Binding BytesTransferred}"
                                   Foreground="{DynamicResource RetroFSInfoBrush}"
                                   FontSize="32"
                                   FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Time Range Selector -->
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="Time Range:"
                           Foreground="{DynamicResource RetroFSLightGrayBrush}"
                           VerticalAlignment="Center"/>
                <ComboBox SelectedItem="{Binding SelectedTimeRange}"
                          Width="150"
                          Background="{DynamicResource RetroFSBackgroundLightBrush}"
                          Foreground="{DynamicResource RetroFSWhiteBrush}">
                    <ComboBoxItem Content="Last 12 Hours"/>
                    <ComboBoxItem Content="Last 1 Week"/>
                    <ComboBoxItem Content="Last 1 Month"/>
                </ComboBox>
            </StackPanel>

            <!-- Charts -->
            <Border Background="{DynamicResource RetroFSBackgroundLightBrush}"
                    BorderBrush="{DynamicResource RetroFSBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="15">
                <StackPanel Spacing="10">
                    <TextBlock Text="Requests Over Time"
                               Foreground="{DynamicResource RetroFSWhiteBrush}"
                               FontSize="16"
                               FontWeight="Bold"/>
                    <lvc:CartesianChart Series="{Binding RequestsSeries}"
                                        Height="200"
                                        Background="{DynamicResource RetroFSBackgroundBrush}"/>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource RetroFSBackgroundLightBrush}"
                    BorderBrush="{DynamicResource RetroFSBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="15">
                <StackPanel Spacing="10">
                    <TextBlock Text="Data Transfer (MB)"
                               Foreground="{DynamicResource RetroFSWhiteBrush}"
                               FontSize="16"
                               FontWeight="Bold"/>
                    <lvc:CartesianChart Series="{Binding BytesSeries}"
                                        Height="200"
                                        Background="{DynamicResource RetroFSBackgroundBrush}"/>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource RetroFSBackgroundLightBrush}"
                    BorderBrush="{DynamicResource RetroFSBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="15">
                <StackPanel Spacing="10">
                    <TextBlock Text="Files Transferred"
                               Foreground="{DynamicResource RetroFSWhiteBrush}"
                               FontSize="16"
                               FontWeight="Bold"/>
                    <lvc:CartesianChart Series="{Binding FilesSeries}"
                                        Height="200"
                                        Background="{DynamicResource RetroFSBackgroundBrush}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
